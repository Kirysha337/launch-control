{
  "name": "launch-control",
  "version": "1.0.0",
  "description": "Центр управления космическими пусками: учёт пусков, подготовки, топлива, площадок, телеметрии и метеообеспечения (MVC, TypeScript, SQLite); лаба №4 — прогноз внешней метеослужбы с таймаутом и ручным вводом",
  "main": "src/app.ts",
  "scripts": {
    "start": "tsx src/app.ts",
    "dev": "tsx watch src/app.ts",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "meteo-mock": "tsx tools/meteo-mock.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=20"
  }
}
